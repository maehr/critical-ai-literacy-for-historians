{
	"name": "critical-ai-literacy-for-historians",
	"description": "Structured exercises for developing critical AI literacy in historical research",
	"author": "Moritz Mähr <moritz.maehr@unibe.ch>",
	"url": "https://github.com/maehr/critical-ai-literacy-for-historians/issues",
	"license": "AGPL-3.0",
	"scripts": {
		"check": "prettier --check .",
		"commit": "cz",
		"format": "prettier --write . && bibtex-tidy bibliography.bib -m --sort --duplicates --no-wrap",
		"prepare": "husky",
		"changelog": "npm exec git-cliff -- --config cliff.toml"
	},
	"devDependencies": {
		"bibtex-tidy": "^1.14.0",
		"commitizen": "^4.3.1",
		"cz": "^1.8.2",
		"cz-conventional-changelog": "^3.3.0",
		"git-cliff": "^2.10.1",
		"husky": "^9.1.7",
		"prettier": "^3.6.2"
	},
	"type": "module",
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	}
}
